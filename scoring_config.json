    "modifiedAt": "2026-09-26T09:16:17+09:00",
    "description": "ViewerのFilter既定値と自ランク既定値はviewerDefaultsで管理する。通常9枠は自ランク別の履歴マッチング比率でバケット配分し、残る1枠はバケット横断スコアで選出する。枠内順位にはRealtime・Phase・候補集合内のエリア密度を使用する。PRIDEは全体を1つのslotBucketとして扱い、PRIDE_A〜Gの履歴比率をsoft priorとして内部順位へ反映するが、rankActivitySignalはPink管理対象だけに適用する。areaBoost.recentMatchは直近5件のコピー実績に現れたエリアを対象とし、各エリアの出現回数を直近最多回数で割った値の平方根にweightを掛け、通常枠と横断1枠の選出スコアへ最大10%加点する。excludePinkManaged=trueによりPink管理対象にはこの直近エリア加点を適用しない。候補集合内の静的エリア密度加点とは独立して機能し、エリアPhase集中は診断ログ専用とする。Pink管理対象のPhase不一致時はphaseErrorに応じた連続減衰を適用し、最終表示10枠での占有数はmaxPinkManagedSlotsで制限する。experimental.softmaxBacktestは本番選出に影響しない。"
  },
  "viewerDefaults": {
    "filterMinutes": 30,
    "myRankKey": "R7"
  },
  "candidateSelection": {
    "maxPinkManagedSlots": 3,
    "slotAllocation": {
      "prideBandPriorExponent": 0.5,
      "prideBandDiversityGapThreshold": 0.08
    },
    "areaBoost": {
      "enabled": true,
      "weight": 0.05,
      "smoothingSampleSize": 30,
      "recentMatch": {
        "enabled": true,
        "weight": 0.10,
        "excludePinkManaged": true
      },
      "diagnosticRecentWeight": 0.10,
      "diagnosticPhaseWeight": 0.05
    }
  },
  "phase": {
    "weight": 0.80,
    "yellow": {
      "baseCycleSec": 345,
      "alpha": 0.12,
      "maxShiftSec": 30,
      "minSamples": 8
    },
    "pink": {
      "weight": 1.00,
      "baseCycleSec": 345,
      "alpha": 0.18,
      "maxShiftSec": 45,
      "minSamples": 8
    }
  },
  "phaseError": {
    "scaleSec": 90,
    "yellowThreshold": 0.70,
    "pinkThreshold": 0.55,
    "yellowLambda": 0.03,
    "pinkLambda": 0.03
  },
  "realtimeBoost": {
    "decaySec": 3600,
    "playerWeight": 0.35,
    "rankWeight": 0.03,
    "maxBonus": 0.25,
    "pinkMismatch": {
      "floor": 0.3,
      "decaySec": 60
    }
  },
  "experimental": {
    "softmaxBacktest": {
      "enabled": true,
      "temperature": 0.15
    }
  }
}
